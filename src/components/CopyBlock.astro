---
// The CFOKit CopyBlock (web/src/components/CopyBlock.tsx in cfokit/cfokit): text to copy, on
// `sunken`, with a Copy button that says Copied once it has.
interface Props {
  label: string;
  text: string;
}
const { label, text } = Astro.props;
---

<figure class="flex flex-col gap-2" data-copy-block>
  <div class="flex items-center justify-between gap-3">
    <figcaption class="text-label text-ink">{label}</figcaption>
    <button
      type="button"
      class="inline-flex min-h-target-min cursor-pointer items-center justify-center px-3 text-body text-accent underline underline-offset-3 hover:text-accent-hover"
      data-copy
    >Copy</button>
  </div>
  <pre class="rounded-md border border-rule bg-sunken p-4 font-sans text-body break-words whitespace-pre-wrap text-ink"><code>{text}</code></pre>
</figure>

<script>
  for (const block of document.querySelectorAll<HTMLElement>('[data-copy-block]')) {
    const button = block.querySelector<HTMLButtonElement>('[data-copy]');
    const text = block.querySelector('pre')?.textContent ?? '';
    button?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(text);
        button.textContent = 'Copied';
      } catch {
        button.textContent = 'Copy';
      }
    });
  }
</script>
