---
// The self-host page, for developers and contributors.
import Page from '../../layouts/Page.astro';
import Button from '../../components/Button.astro';
import Card from '../../components/Card.astro';
import CopyBlock from '../../components/CopyBlock.astro';
import TextField from '../../components/TextField.astro';

const repo = 'https://github.com/cfokit/cfokit';
const sectionHeading = 'font-display text-heading-compact tablet:text-heading';
const checks = [
  { title: 'Exact amounts', body: 'Decimal throughout. A balance is the exact sum of its postings, with no drift.', accent: false },
  { title: 'Append-only', body: 'A posted entry is never edited. Corrections are reversing entries, and both stay visible.', accent: false },
  {
    title: 'Tested against published answers',
    body: 'The booking engine is checked against worked examples it did not write, not against its own assumptions.',
    accent: true,
  },
];
const parts = [
  'A double-entry ledger on Postgres',
  'An MCP server and a documented HTTP API',
  'The bookkeeper Agent Skill, as a plugin for your own Claude',
  'Sign-in through its own identity provider',
];
---

<Page
  title="Run CFOKit yourself"
  description="CFOKit runs on your own machine with Docker. Apache 2.0, no cloud account, no signup."
  action={{ label: 'View on GitHub', href: repo }}
>
  <section class="flex max-w-reading-max flex-col gap-4 pt-10 pb-10 tablet:pt-[64px]">
    <p class="text-label text-ink-muted">For developers and contributors</p>
    <h1 class="font-display text-display-compact tablet:text-display">Run CFOKit yourself.</h1>
    <p class="text-title font-normal">
      The whole product on your own machine. Apache 2.0, with no cloud account, no signup, and
      nothing held back.
    </p>
  </section>

  <section class="flex flex-wrap items-start gap-6 pb-10">
    <Card class="min-w-0 flex-[2_1_420px]">
      <h2 class="text-title">Up in two commands</h2>
      <p>You need Docker and nothing else.</p>
      <CopyBlock label="In your CFOKit checkout" text={'docker compose up -d --wait\ndocker compose --profile migrate run --rm migrate'} />
      <p>Then open the app at localhost, create your account, bring in your QuickBooks export and connect Claude.</p>
      <Button href={`${repo}/blob/main/docs/tutorials/run-cfokit-on-your-computer.md`} class="self-start">Read the setup guide</Button>
    </Card>
    <div class="flex min-w-0 flex-[1_1_280px] flex-col gap-3">
      <h2 class="text-title">What comes up</h2>
      <ul class="flex flex-col border-b border-rule">
        {parts.map((part) => <li class="border-t border-rule py-3">{part}</li>)}
      </ul>
    </div>
  </section>

  <section class="flex flex-col gap-6 border-t border-rule py-10">
    <h2 class={sectionHeading}>Built to be checked</h2>
    <div class="grid gap-6 tablet:grid-cols-3">
      {checks.map((check) => (
        <div class:list={['flex flex-col gap-2 border-t-2 pt-4', check.accent ? 'border-ochre' : 'border-ink']}>
          <h3 class="text-title">{check.title}</h3>
          <p class="text-ink-muted">{check.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="flex flex-wrap gap-10 border-t border-rule py-10">
    <div class="flex min-w-0 max-w-reading-max flex-[1_1_320px] flex-col gap-4">
      <h2 class={sectionHeading}>Build it with us</h2>
      <p>
        Write the connector for your own bank, or the compliance rules for your own state. Adding a
        bank or a payment provider is an additive change behind a stable extension point, so your
        work lands without a rewrite.
      </p>
      <div class="flex flex-wrap gap-3">
        <Button variant="primary" href={repo}>View on GitHub</Button>
        <Button variant="link" href={`${repo}/blob/main/CONTRIBUTING.md`}>How to contribute</Button>
      </div>
    </div>
    <Card class="min-w-0 flex-[1_1_340px]">
      <h2 class="text-title">Hear about releases</h2>
      <form data-cmokit-convert="releases_signup" class="flex flex-col gap-4">
        <TextField
          id="releases-email"
          label="Email"
          type="email"
          name="email"
          autocomplete="email"
          placeholder="you@example.com"
          help="One email per release. Unsubscribe any time."
          required
        />
        <Button type="submit" fullWidth>Email me releases</Button>
      </form>
      <p data-thanks role="status">Thanks. We'll email you when there's a new release.</p>
    </Card>
  </section>

  <section class="border-t border-rule pt-10 pb-10 tablet:pb-[64px]">
    <Card class="flex-row flex-wrap items-center justify-between">
      <div class="flex min-w-0 flex-[1_1_320px] flex-col gap-2">
        <h2 class="text-title">Rather not run it yourself?</h2>
        <p class="text-ink-muted">Join the closed beta, and we'll email you when there's a place for your company.</p>
      </div>
      <Button href="/#beta">Join the closed beta</Button>
    </Card>
  </section>
</Page>
