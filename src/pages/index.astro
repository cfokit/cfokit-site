---
// The home page, for founders: the hosted waitlist first, then using CFOKit from your own Claude
// today, then running it yourself.
import Page from '../layouts/Page.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import TextField from '../components/TextField.astro';

const label = 'text-label text-accent';
const sectionHeading = 'font-display text-heading-compact tablet:text-heading';
const points = [
  {
    title: 'Current to yesterday',
    body: 'Transactions arrive from your bank, card and payment feeds and are recorded as they come in, not weeks after month end.',
  },
  {
    title: 'Every number explains itself',
    body: 'Each posting names the rule and the source transaction behind it, so you can see why it landed where it did.',
  },
  {
    title: 'Asked once, never again',
    body: "What a rule can't decide is asked, not guessed. Approve the rule, and the same question doesn't come back.",
  },
  {
    title: 'Nothing posted is edited',
    body: 'Corrections are reversing entries, so the history is complete. Periods close on the schedule you set.',
  },
];
---

<Page
  title="CFOKit: your books, done for you"
  description="CFOKit does the bookkeeper's and the controller's work for your company. Join the waitlist for hosted CFOKit, use it today from your own Claude, or run it yourself."
>
  <section class="flex max-w-reading-max flex-col gap-4 pt-10 pb-10 tablet:pt-[64px]">
    <p class="text-label text-ink-muted">Bookkeeping for founders</p>
    <h1 class="font-display text-display-compact tablet:text-display">Your books, done for you.</h1>
    <p class="text-title font-normal">
      CFOKit does the bookkeeper's and the controller's work for your company. You decide how much
      control to keep: let us run it, work from your own Claude, or host it yourself. Everything it
      learns about your business exports with your books, any time.
    </p>
  </section>

  <section id="waitlist" class="flex flex-wrap gap-6 pb-10">
    <Card featured class="min-w-0 flex-[1_1_340px]">
      <p class={label}>Hosted, nothing to install</p>
      <h2 class="text-title">A bookkeeper agent that keeps your books for you.</h2>
      <p>
        It maintains your books on its own and comes to you when it needs your guidance. You oversee
        the work, and we run everything.
      </p>
      <form data-cmokit-convert="hosted_signup" class="flex flex-col gap-4">
        <TextField
          id="waitlist-email"
          label="Work email"
          type="email"
          name="email"
          autocomplete="email"
          placeholder="you@company.com"
          help="We'll email you when hosted CFOKit opens for your company."
          required
        />
        <Button variant="primary" type="submit" fullWidth>Join the waitlist</Button>
      </form>
      <p data-thanks role="status" class="text-body">Thanks. You're on the list, and we'll email you when it opens.</p>
    </Card>

    <Card class="min-w-0 flex-[1_1_340px]">
      <p class={label}>Available now</p>
      <h2 class="text-title">Use it today from your own Claude.</h2>
      <p>
        Create a hosted account, then add the CFOKit plugin and connector to Claude desktop or
        claude.ai. Your Claude keeps the books. We run the ledger.
      </p>
      <Button href="https://app.cfokit.ai" class="self-start">Create your account</Button>
      <Button variant="link" href="https://github.com/cfokit/cfokit/blob/main/docs/how-to/connect-claude.md" class="self-start px-0">How to connect Claude</Button>
    </Card>

    <Card class="min-w-0 flex-[1_1_340px]">
      <p class={label}>Self-hosted</p>
      <h2 class="text-title">Run it yourself, free.</h2>
      <p>The same software, Apache 2.0 licensed. It runs on your laptop with no cloud account and no signup.</p>
      <pre class="rounded-sm bg-sunken px-4 py-3 text-body break-words whitespace-pre-wrap"><code>docker compose up -d --wait</code></pre>
      <Button href="/self-host/" class="self-start">See how to self-host</Button>
    </Card>
  </section>

  <section class="flex flex-col gap-6 border-t border-rule py-10">
    <h2 class={sectionHeading}>Books you can trust without checking them</h2>
    <div class="grid gap-6 tablet:grid-cols-2 desktop:grid-cols-4">
      {points.map((point) => (
        <div class="flex flex-col gap-2 border-t-2 border-ink pt-4">
          <h3 class="text-title">{point.title}</h3>
          <p class="text-ink-muted">{point.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="flex flex-col gap-6 border-t border-rule py-10">
    <h2 class={sectionHeading}>Works in the Claude you already use</h2>
    <ol class="flex max-w-reading-max flex-col gap-4">
      <li class="flex gap-4">
        <span class="font-display text-heading text-ochre">1</span>
        <span><strong>Add the CFOKit plugin.</strong> It carries the bookkeeper skill.</span>
      </li>
      <li class="flex gap-4">
        <span class="font-display text-heading text-ochre">2</span>
        <span><strong>Add the connector</strong> and sign in with your CFOKit account.</span>
      </li>
      <li class="flex gap-4">
        <span class="font-display text-heading text-ochre">3</span>
        <span><strong>Allow Claude in your company,</strong> then bring your books in.</span>
      </li>
    </ol>
  </section>

  <section class="flex flex-col items-start gap-4 border-t border-rule pt-10 pb-10 tablet:pb-[64px]">
    <h2 class={sectionHeading}>Your company owns its books</h2>
    <p class="max-w-reading-max">
      Hosted or on your own machine, the account belongs to your company, never to its accountant or
      its fractional CFO. They work inside it at your invitation.
    </p>
    <Button variant="primary" href="#waitlist">Join the waitlist</Button>
  </section>
</Page>
